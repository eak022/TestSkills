model Game {
  id        Int          @id @default(autoincrement())
  name      String
  status    Status
  packages  Package[]
  topUp     TopUp[]
  server    GameServer[]
  orders    Order[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?
  createdBy Json?
  updatedBy Json?

  @@map("game")
}

model GameServer {
  id         Int     @id @default(autoincrement())
  serverName String
  topUp      TopUp[]
  orders     Order[]
  game       Game    @relation(fields: [gameId], references: [id])
  gameId     Int

  @@map("gameServer")
}
