model Package {
  id        Int       @id @default(autoincrement())
  name      String
  amount    Int //จำนวนที่เติม เช่น เพรช หรืออย่างอื่นตามแต่ล่ะเกม
  price     Decimal
  topUp     TopUp[]
  orders    Order[]
  status    Status
  game      Game      @relation(fields: [gameId], references: [id])
  gameId    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy Json?
  updatedBy Json?

  @@map("package")
}
